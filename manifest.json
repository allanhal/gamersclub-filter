{
  "manifest_version": 3,
  "name": "olx-filter",
  "description": "Extensão para OLX que filtra anúncios do DIEGO.",
  "version": "1.0.0",
  "icons": {
    "256": "icon_256.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.olx.com.br/*", "https://olx.com.br/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.olx.com.br/*", "https://olx.com.br/*"],
      "js": ["content.js"]
    }
  ]
}
